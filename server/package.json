{
  "name": "mindcare-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "host": "tsx index.ts --host-site",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:content": "tsx prisma/add-content.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:studio": "prisma studio",
    "sanity:export": "tsx prisma/export-sanity.ts",
    "test": "tsx --test prisma/sanity/portableText.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.16.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.21",
    "prisma": "^7.8.0",
    "typescript": "~5.8.2"
  },
  "description": "",
