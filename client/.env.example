# Copy to .env for local overrides. Never commit real values.

# Sanity (read by the browser and the build; the dataset is public, so these are not secrets).
# Both default to the live project when unset.
VITE_SANITY_PROJECT_ID=v75epg3m
VITE_SANITY_DATASET=production

# Bookings Sheet: server-side only, read by api/book.ts. Set these in Vercel
# (Project -> Settings -> Environment Variables), never with a VITE_ prefix,
# so they never reach the browser or the built files.
# The ID is the long part of the Sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit
BOOKINGS_SHEET_ID=
# The service account's whole key file, as one line of JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
