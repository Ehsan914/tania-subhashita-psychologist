{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && npm run build:studio",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/therapies", "destination": "/services", "permanent": true },
    { "source": "/therapies/:slug", "destination": "/services/:slug", "permanent": true },
    { "source": "/journal", "destination": "/blog", "permanent": true },
    { "source": "/journal/:slug", "destination": "/blog/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/studio/:path*", "destination": "/studio/index.html" },
    { "source": "/static/:file(favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|manifest\\.webmanifest)", "destination": "/studio/static/:file" }
  ],
  "headers": [
    { "source": "/studio/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
