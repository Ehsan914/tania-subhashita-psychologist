# Copy to .env and fill in. From sanity.io/manage → your project.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# The site's bookings function, called by the Bookings tool with your Sanity sign-in.
# Not a secret: the function itself checks who is signed in. Leave empty to show the tool's
# "not set" notice. Local: http://localhost:3000/api/bookings under `vercel dev`.
SANITY_STUDIO_BOOKINGS_API=https://taniasubhashita.com/api/bookings
